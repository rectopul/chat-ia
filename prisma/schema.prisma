generator client {
  provider = "prisma-client-js"
  output   = env("PRISMA_CLIENT_OUTPUT")
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
}

enum UserAccessStatus {
  ACTIVE
  BANNED
}

enum PlanType {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

model User {
  id                     String           @id @default(cuid())
  name                   String?
  email                  String?          @unique
  phone                  String?          @unique
  password               String?
  termsAcceptedAt        DateTime?
  assistantName          String?
  businessProfile        BusinessProfile  @default(GROCERY)
  closedMessage          String?          @db.Text
  manualStoreClosed      Boolean          @default(false)
  deliveryFeeCents       Int              @default(0)
  storeAddress           String?          @db.Text
  acceptedPaymentMethods PaymentMethod[]  @default([])
  availableDeliveryTypes DeliveryType[]   @default([DELIVERY])
  role                   UserRole         @default(CUSTOMER)
  accessStatus           UserAccessStatus @default(ACTIVE)
  aiMessageLimitOverride Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  bots              BotAccount[]
  products          Product[]
  templates         MessageTemplate[]
  subscription      Subscription?
  transactions      Transaction[]
  whatsappInstances WhatsappInstance[]
  whatsappCustomers WhatsappCustomer[]
  orders            Order[]            @relation("UserOrders")
  whatsappHandovers WhatsappHandover[]
  operatingHours    OperatingHour[]    @relation("SubscriberOperatingHours")
  tags              Tag[]              @relation("SubscriberTags")
  productTags       ProductTags[]      @relation("SubscriberProductTags")
}

model OperatingHour {
  id           String  @id @default(uuid())
  subscriberId String
  dayOfWeek    Int
  openTime     String
  closeTime    String
  isOpen       Boolean @default(true)
  timezone     String  @default("America/Sao_Paulo")

  subscriber User @relation("SubscriberOperatingHours", fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId, dayOfWeek])
}

model WhatsappInstance {
  id           String   @id @default(cuid())
  userId       String
  instanceName String
  status       String   @default("DISCONNECTED")
  webhookUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  handovers WhatsappHandover[]
  customers WhatsappCustomer[]

  @@unique([userId, instanceName])
  @@index([userId, status])
}

enum WhatsappHandoverStatus {
  OPEN
  RESOLVED
}

model WhatsappHandover {
  id                  String                 @id @default(cuid())
  userId              String
  whatsappInstanceId  String
  chatId              String
  triggerText         String?                @db.Text
  lastCustomerMessage String?                @db.Text
  triggerKeywords     String[]               @default([])
  status              WhatsappHandoverStatus @default(OPEN)
  resolvedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance @relation(fields: [whatsappInstanceId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([whatsappInstanceId, chatId, status])
}

model WhatsappCustomer {
  id                 String   @id @default(cuid())
  ownerUserId        String
  whatsappInstanceId String?
  whatsappId         String
  displayName        String?
  lastMessageText    String?  @db.Text
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerUser        User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  whatsappInstance WhatsappInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, whatsappId])
  @@index([ownerUserId, lastSeenAt])
  @@index([whatsappInstanceId, lastSeenAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  planType              PlanType           @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  startDate             DateTime           @default(now())
  endDate               DateTime?
  graceUntil            DateTime?
  gatewaySubscriptionId String?            @unique
  planPriceCents        Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id                    String            @id @default(cuid())
  userId                String
  subscriptionId        String?
  amountCents           Int
  currency              String            @default("BRL")
  status                TransactionStatus @default(PENDING)
  referenceDate         DateTime          @default(now())
  paidAt                DateTime?
  gatewayReference      String?           @unique
  gatewaySubscriptionId String?
  rawPayload            Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, referenceDate])
  @@index([userId, createdAt])
}

enum BusinessProfile {
  GROCERY
  RESTAURANT
  SNACK_BAR
  EVENT
}

enum PaymentMethod {
  PIX_ONLINE
  PIX_DELIVERY
  CARD_DELIVERY
  CASH
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

model BotAccount {
  id                     String          @id @default(cuid())
  businessProfile        BusinessProfile @default(GROCERY)
  acceptedPaymentMethods PaymentMethod[] @default([])
  availableDeliveryTypes DeliveryType[]  @default([DELIVERY])
  ownerUserId            String?
  name                   String
  token                  String?         @unique
  webhookSecret          String?
  apiId                  Int?
  apiHash                String?
  businessBotToken       String?
  phoneNumber            String?         @unique
  session                String?         @db.Text
  isUserAccount          Boolean         @default(false)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  ownerUser         User?                 @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  users             TelegramUser[]
  sales             Sale[]
  messageLogs       MessageLog[]
  chatMessages      ChatMessage[]
  scheduledJobs     ScheduledMessageJob[]
  rules             TimedMessageRule[]
  recurring         RecurringSchedule[]
  pixAudioConfig    PixAudioConfig?
  discountConfig    DiscountConfig?
  dontSellIntervals DontSellInterval[]

  @@index([ownerUserId])
}

model RecurringSchedule {
  id         String  @id @default(cuid())
  botId      String
  templateId String
  hour       Int
  minute     Int
  weekDays   Int[]
  isActive   Boolean @default(true)

  bot      BotAccount      @relation(fields: [botId], references: [id], onDelete: Cascade)
  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model TelegramUser {
  id              String    @id @default(cuid())
  botId           String
  chatId          String    @unique
  username        String?
  firstName       String?
  lastName        String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  isBlocked       Boolean   @default(false)
  isSubscriber    Boolean   @default(false)
  subscriberUntil DateTime?

  bot            BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramUserId String     @unique

  sales         Sale[]
  messageLogs   MessageLog[]
  scheduledJobs ScheduledMessageJob[]

  @@unique([telegramUserId, botId])
  @@index([lastSeenAt])
}

enum MessageTemplateKey {
  WELCOME
  DONT_SELL
  SUBSCRIBER_CONTENT
  TIMED
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  COMBO
}

model MessageTemplate {
  id             String             @id @default(cuid())
  ownerUserId    String?
  key            MessageTemplateKey
  title          String
  type           MediaType
  text           String?            @db.Text
  mediaUrl       String?
  tags           String[]           @default([])
  telegramFileId String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  ownerUser     User?                  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  mediaItems    MessageTemplateMedia[]
  rules         TimedMessageRule[]
  scheduledJobs ScheduledMessageJob[]
  recurring     RecurringSchedule[]

  @@index([ownerUserId])
}

model MessageTemplateMedia {
  id             String    @id @default(cuid())
  templateId     String
  type           MediaType
  url            String
  order          Int       @default(0)
  tags           String[]  @default([])
  telegramFileId String?

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

enum UserSegment {
  NEW_USERS
  ALL
  BUYERS
  NON_BUYERS
}

model TimedMessageRule {
  id                    String                @id @default(cuid())
  botId                 String
  name                  String
  isActive              Boolean               @default(true)
  delaySeconds          Int
  repeatIntervalSeconds Int?
  segment               UserSegment
  templateId            String
  template              MessageTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  bot                   BotAccount            @relation(fields: [botId], references: [id], onDelete: Cascade)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  jobs                  ScheduledMessageJob[]
}

enum JobStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

model ScheduledMessageJob {
  id             String @id @default(cuid())
  botId          String
  telegramUserId String
  chatId         String
  templateId     String

  bot      BotAccount       @relation(fields: [botId], references: [id], onDelete: Cascade)
  user     TelegramUser     @relation(fields: [telegramUserId, botId], references: [telegramUserId, botId], onDelete: Cascade)
  template MessageTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ruleId   String
  rule     TimedMessageRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  runAt     DateTime
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

model BusinessConnection {
  id             String   @id @default(cuid())
  connectionId   String   @unique
  botId          String
  userTelegramId String
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

enum ProductType {
  ONE_TIME
  SUBSCRIPTION
}

model Tag {
  id           String @id @default(uuid())
  name         String
  subscriberId String

  subscriber  User          @relation("SubscriberTags", fields: [subscriberId], references: [id], onDelete: Cascade)
  productTags ProductTags[]

  @@unique([subscriberId, name])
  @@index([subscriberId])
}

model Product {
  id                    String      @id @default(cuid())
  ownerUserId           String?
  title                 String
  description           String?
  imageUrl              String?
  priceCents            Int
  promotionalPriceCents Int?
  stockQuantity         Int?
  category              String?
  currency              String      @default("BRL")
  isActive              Boolean     @default(true)
  productType           ProductType @default(ONE_TIME)
  subscriberDays        Int?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  ownerUser       User?            @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  sales           Sale[]
  discountConfigs DiscountConfig[]
  orderItems      OrderItem[]
  productTags     ProductTags[]

  @@index([ownerUserId])
  @@index([ownerUserId, category, isActive])
}

model ProductTags {
  productId    String
  tagId        String
  subscriberId String

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag        Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  subscriber User    @relation("SubscriberProductTags", fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([subscriberId, productId])
  @@index([subscriberId, tagId])
  @@index([tagId])
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
}

model Order {
  id                 String         @id @default(cuid())
  ownerUserId        String?
  whatsappInstanceId String?
  customerWhatsappId String
  customerName       String?
  status             OrderStatus    @default(PENDING)
  paymentMethod      PaymentMethod?
  paymentStatus      String         @default("PENDING")
  deliveryType       DeliveryType?
  changeAmount       Float?
  pixPayload         String?        @db.Text
  deliveryFeeCents   Int            @default(0)
  totalCents         Int
  currency           String         @default("BRL")
  deliveryAddress    String
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  ownerUser        User?             @relation("UserOrders", fields: [ownerUserId], references: [id], onDelete: SetNull)
  whatsappInstance WhatsappInstance? @relation(fields: [whatsappInstanceId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@index([ownerUserId, status, createdAt])
  @@index([whatsappInstanceId, customerWhatsappId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  subtotalCents  Int
  createdAt      DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum SaleStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

model Sale {
  id             String     @id @default(cuid())
  botId          String
  telegramUserId String
  productId      String
  status         SaleStatus @default(PENDING)
  referenceId    String     @unique
  provider       String     @default("SYNCPAY")
  amountCents    Int
  currency       String     @default("BRL")
  rawPayload     Json?
  paidAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  bot     BotAccount   @relation(fields: [botId], references: [id], onDelete: Cascade)
  user    TelegramUser @relation(fields: [telegramUserId, botId], references: [telegramUserId, botId], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([telegramUserId, paidAt])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  referenceId String?
  rawPayload  Json
  receivedAt  DateTime @default(now())
}

enum MessageDirection {
  IN
  OUT
}

model MessageLog {
  id                String           @id @default(cuid())
  botId             String
  telegramUserId    String
  direction         MessageDirection
  type              MediaType
  text              String?          @db.Text
  mediaUrl          String?
  providerMessageId String?
  createdAt         DateTime         @default(now())

  bot  BotAccount   @relation(fields: [botId], references: [id], onDelete: Cascade)
  user TelegramUser @relation(fields: [telegramUserId, botId], references: [telegramUserId, botId], onDelete: Cascade)
}

model PixAudioConfig {
  id          String   @id @default(cuid())
  botId       String   @unique
  audioUrl    String
  fileName    String
  durationSec Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model DiscountConfig {
  id              String   @id @default(cuid())
  botId           String   @unique
  productId       String
  discountPercent Int
  discountText    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot     BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DontSellInterval {
  id           String   @id @default(cuid())
  botId        String
  delaySeconds Int
  order        Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  bot BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, isActive])
}

model MediaCache {
  id            String   @id @default(uuid())
  url           String   @unique
  telegramDocId String?
  accessHash    String?
  fileReference Bytes?
  mimeType      String?
  size          Int?
  createdAt     DateTime @default(now())
}

enum ScrapingJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TransferStatus {
  PENDING
  TRANSFERRED
  FAILED
  FLOOD_WAIT
  USER_PRIVACY
  NOT_MUTUAL
  ALREADY_PARTICIPANT
}

model GroupScrapingJob {
  id               String            @id @default(cuid())
  botId            String
  sourceGroupId    String
  sourceGroupTitle String?
  targetGroupId    String
  targetGroupTitle String?
  status           ScrapingJobStatus @default(PENDING)
  totalUsers       Int               @default(0)
  scrapedUsers     Int               @default(0)
  transferredUsers Int               @default(0)
  failedUsers      Int               @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?

  scrapedMembers ScrapedUser[]
  transfers      UserTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId])
  @@index([status])
}

model ScrapedUser {
  id        String  @id @default(cuid())
  jobId     String
  userId    String
  username  String?
  firstName String?
  lastName  String?
  phone     String?
  isBot     Boolean @default(false)
  isPremium Boolean @default(false)

  job       GroupScrapingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  transfers UserTransfer[]

  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}

model UserTransfer {
  id             String         @id @default(cuid())
  jobId          String
  scrapedUserId  String
  userId         String
  status         TransferStatus @default(PENDING)
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?
  transferredAt  DateTime?
  error          String?
  floodWaitUntil DateTime?

  job         GroupScrapingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scrapedUser ScrapedUser      @relation(fields: [scrapedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([floodWaitUntil])
}

enum ChatMessageRole {
  user
  model
}

enum ChatMessageType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
}

model ChatMessage {
  botId                String?
  id                   String          @id @default(uuid())
  telegramId           String
  role                 ChatMessageRole
  content              String          @db.Text
  mediaUrl             String?
  messageType          ChatMessageType @default(TEXT)
  aiModel              String?
  promptTokenCount     Int?
  candidatesTokenCount Int?
  totalTokenCount      Int?
  createdAt            DateTime        @default(now())

  bot BotAccount? @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([telegramId, createdAt])
  @@index([botId, telegramId, createdAt])
}
