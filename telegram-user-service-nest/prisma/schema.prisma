generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BotAccount {
  id               String   @id @default(cuid())
  name             String
  token            String?  @unique
  webhookSecret    String?
  apiId            Int?
  apiHash          String?
  businessBotToken String?
  phoneNumber      String?  @unique
  session          String?  @db.Text
  isUserAccount    Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users             TelegramUser[]
  sales             Sale[]
  messageLogs       MessageLog[]
  scheduledJobs     ScheduledMessageJob[]
  rules             TimedMessageRule[]
  recurring         RecurringSchedule[]
  pixAudioConfig    PixAudioConfig?
  discountConfig    DiscountConfig?
  dontSellIntervals DontSellInterval[]
}

model RecurringSchedule {
  id         String  @id @default(cuid())
  botId      String
  templateId String
  hour       Int
  minute     Int
  weekDays   Int[]
  isActive   Boolean @default(true)

  bot      BotAccount      @relation(fields: [botId], references: [id], onDelete: Cascade)
  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model TelegramUser {
  id              String    @id @default(cuid())
  botId           String
  chatId          String    @unique
  username        String?
  firstName       String?
  lastName        String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  isBlocked       Boolean   @default(false)
  isSubscriber    Boolean   @default(false)
  subscriberUntil DateTime?

  bot            BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramUserId String     @unique

  sales         Sale[]
  messageLogs   MessageLog[]
  scheduledJobs ScheduledMessageJob[]

  @@unique([telegramUserId, botId])
  @@index([lastSeenAt])
}

enum MessageTemplateKey {
  WELCOME
  DONT_SELL
  SUBSCRIBER_CONTENT
  TIMED
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  COMBO
}

model MessageTemplate {
  id             String             @id @default(cuid())
  key            MessageTemplateKey
  title          String
  type           MediaType
  text           String?            @db.Text
  mediaUrl       String?
  tags           String[]           @default([])
  telegramFileId String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  mediaItems    MessageTemplateMedia[]
  rules         TimedMessageRule[]
  scheduledJobs ScheduledMessageJob[]
  recurring     RecurringSchedule[]
}

model MessageTemplateMedia {
  id             String    @id @default(cuid())
  templateId     String
  type           MediaType
  url            String
  order          Int       @default(0)
  tags           String[]  @default([])
  telegramFileId String?

  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

enum UserSegment {
  NEW_USERS
  ALL
  BUYERS
  NON_BUYERS
}

model TimedMessageRule {
  id                    String                @id @default(cuid())
  botId                 String
  name                  String
  isActive              Boolean               @default(true)
  delaySeconds          Int
  repeatIntervalSeconds Int?
  segment               UserSegment
  templateId            String
  template              MessageTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  bot                   BotAccount            @relation(fields: [botId], references: [id], onDelete: Cascade)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  jobs                  ScheduledMessageJob[]
}

enum JobStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

model ScheduledMessageJob {
  id             String @id @default(cuid())
  botId          String
  telegramUserId String
  chatId         String
  templateId     String

  bot      BotAccount       @relation(fields: [botId], references: [id], onDelete: Cascade)
  user     TelegramUser     @relation(fields: [telegramUserId, botId], references: [telegramUserId, botId], onDelete: Cascade)
  template MessageTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ruleId   String
  rule     TimedMessageRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  runAt     DateTime
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

model BusinessConnection {
  id             String   @id @default(cuid())
  connectionId   String   @unique
  botId          String
  userTelegramId String
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

enum ProductType {
  ONE_TIME
  SUBSCRIPTION
}

model Product {
  id             String      @id @default(cuid())
  title          String
  description    String?
  priceCents     Int
  currency       String      @default("BRL")
  isActive       Boolean     @default(true)
  productType    ProductType @default(ONE_TIME)
  subscriberDays Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  sales           Sale[]
  discountConfigs DiscountConfig[]
}

enum SaleStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

model Sale {
  id             String     @id @default(cuid())
  botId          String
  telegramUserId String
  productId      String
  status         SaleStatus @default(PENDING)
  referenceId    String     @unique
  provider       String     @default("SYNCPAY")
  amountCents    Int
  currency       String     @default("BRL")
  rawPayload     Json?
  paidAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  bot     BotAccount   @relation(fields: [botId], references: [id], onDelete: Cascade)
  user    TelegramUser @relation(fields: [telegramUserId, botId], references: [telegramUserId, botId], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([telegramUserId, paidAt])
  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  referenceId String?
  rawPayload  Json
  receivedAt  DateTime @default(now())
}

enum MessageDirection {
  IN
  OUT
}

model MessageLog {
  id                String           @id @default(cuid())
  botId             String
  telegramUserId    String
  direction         MessageDirection
  type              MediaType
  text              String?          @db.Text
  mediaUrl          String?
  providerMessageId String?
  createdAt         DateTime         @default(now())

  bot  BotAccount   @relation(fields: [botId], references: [id], onDelete: Cascade)
  user TelegramUser @relation(fields: [telegramUserId, botId], references: [telegramUserId, botId], onDelete: Cascade)
}

model PixAudioConfig {
  id          String   @id @default(cuid())
  botId       String   @unique
  audioUrl    String
  fileName    String
  durationSec Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model DiscountConfig {
  id              String   @id @default(cuid())
  botId           String   @unique
  productId       String
  discountPercent Int
  discountText    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bot     BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DontSellInterval {
  id           String   @id @default(cuid())
  botId        String
  delaySeconds Int
  order        Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  bot BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, isActive])
}

model MediaCache {
  id            String   @id @default(uuid())
  url           String   @unique
  telegramDocId String?
  accessHash    String?
  fileReference Bytes?
  mimeType      String?
  size          Int?
  createdAt     DateTime @default(now())
}

enum ScrapingJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TransferStatus {
  PENDING
  TRANSFERRED
  FAILED
  FLOOD_WAIT
  USER_PRIVACY
  NOT_MUTUAL
  ALREADY_PARTICIPANT
}

model GroupScrapingJob {
  id               String            @id @default(cuid())
  botId            String
  sourceGroupId    String
  sourceGroupTitle String?
  targetGroupId    String
  targetGroupTitle String?
  status           ScrapingJobStatus @default(PENDING)
  totalUsers       Int               @default(0)
  scrapedUsers     Int               @default(0)
  transferredUsers Int               @default(0)
  failedUsers      Int               @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  error            String?

  scrapedMembers ScrapedUser[]
  transfers      UserTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId])
  @@index([status])
}

model ScrapedUser {
  id        String  @id @default(cuid())
  jobId     String
  userId    String
  username  String?
  firstName String?
  lastName  String?
  phone     String?
  isBot     Boolean @default(false)
  isPremium Boolean @default(false)

  job       GroupScrapingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  transfers UserTransfer[]

  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}

model UserTransfer {
  id             String         @id @default(cuid())
  jobId          String
  scrapedUserId  String
  userId         String
  status         TransferStatus @default(PENDING)
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?
  transferredAt  DateTime?
  error          String?
  floodWaitUntil DateTime?

  job         GroupScrapingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scrapedUser ScrapedUser      @relation(fields: [scrapedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([floodWaitUntil])
}

enum ChatMessageRole {
  user
  model
}

model ChatMessage {
  id         String          @id @default(uuid())
  telegramId String
  role       ChatMessageRole
  content    String          @db.Text
  createdAt  DateTime        @default(now())

  @@index([telegramId, createdAt])
}
